<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 状态栏胶囊(实时活动)必需:荣耀灵动胶囊 / 小米超级岛 / OPPO 实况通知等
         都只提升满足 Android 16 Live Updates 规范的通知,声明本权限是其中一条硬条件。
         非运行时权限,声明即可;用户可在系统「实时活动」设置里单独关闭。 -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 上课自动免打扰:切换系统免打扰状态需要「勿扰访问权限」,由用户在系统设置里授予 -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 提醒触发时短时唤醒,保证在系统再次休眠前读完数据并发出通知 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 应用内更新:下载 APK 后拉起系统安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".ClasstableApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Classtable">

        <!--
          桌面入口交给下面 9 个 activity-alias:每个 alias 一套图标、名字相同,同一时刻只启用一个,
          用户在「设置 → 外观 → 应用图标」里切换(切换逻辑见 icon/AppIcon.kt)。
          MainActivity 自身不再挂 LAUNCHER,否则桌面上会出现两个入口。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- 图标 1/9:向左看 -->
        <activity-alias
            android:name=".IconAlias01"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/app_icon_01"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 图标 2/9:正面(出厂默认) -->
        <activity-alias
            android:name=".IconAlias02"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/app_icon_02"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 图标 3/9:睡觉 -->
        <activity-alias
            android:name=".IconAlias03"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/app_icon_03"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 图标 4/9:向右看 -->
        <activity-alias
            android:name=".IconAlias04"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/app_icon_04"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 图标 5/9:看书 -->
        <activity-alias
            android:name=".IconAlias05"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/app_icon_05"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 图标 6/9:惊讶 -->
        <activity-alias
            android:name=".IconAlias06"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/app_icon_06"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 图标 7/9:喝茶 -->
        <activity-alias
            android:name=".IconAlias07"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/app_icon_07"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 图标 8/9:眨眼 -->
        <activity-alias
            android:name=".IconAlias08"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/app_icon_08"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 图标 9/9:背影 -->
        <activity-alias
            android:name=".IconAlias09"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/app_icon_09"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 应用内更新:向系统安装器暴露 filesDir/updates 下的 APK -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 课程提醒闹钟接收器(PendingIntent 显式指定,无需 intent-filter) -->
        <receiver
            android:name=".notify.CourseReminderReceiver"
            android:exported="false" />

        <!-- 上课自动免打扰的进入 / 退出闹钟接收器 -->
        <receiver
            android:name=".notify.DndReceiver"
            android:exported="false" />

        <!-- 实时活动通知上的操作按钮(取消本节课提醒) -->
        <receiver
            android:name=".notify.LiveUpdateActionReceiver"
            android:exported="false" />

        <!--
          课程实时活动前台服务:课前倒计时 / 上课中 / 下课,后台启动受限时由接收器兜底。
          类型用 specialUse 而不是 dataSync:实时活动属于「持续展示进行中状态」,
          在 Android 15+ 上 dataSync 受每日时长上限约束,且胶囊类机型按 specialUse 判定。
          子类型说明是 Play / 系统审核要求的用途声明。
        -->
        <service
            android:name=".notify.CourseLiveUpdateService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Course reminder live update: shows the ongoing class countdown from the lead time until the class ends" />
        </service>

        <!-- 开机 / 改时区 / 改时间 / 应用更新后重排提醒 -->
        <receiver
            android:name=".notify.BootRescheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- 精确闹钟权限被授予/收回后要换用对应的闹钟类型 -->
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- FCM 推送 -->
        <service
            android:name=".data.FcmMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".widget.NextClassWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_next_class">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_class_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.TodayWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_today">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.TomorrowWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_tomorrow">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tomorrow_widget_info" />
        </receiver>

    </application>

</manifest>
